<Page x:Class="AMTech.Pages.AddComponentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Товар">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Название"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TBName" Text="{Binding Name}" MaxLength="150"
                 ToolTip="Полное название товара"/>

        <Label Grid.Row="1" Content="Производитель"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TBManufacturer" Text="{Binding Manufacturer}" MaxLength="100"
                 ToolTip="Например: AMD, Intel, MSI"/>

        <Label Grid.Row="2" Content="Категория"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CBCategory" SelectedValuePath="Id"
                  SelectedValue="{Binding CategoryId}" ToolTip="Выберите категорию"/>

        <Label Grid.Row="3" Content="Поставщик"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CBSupplier" SelectedValuePath="Id"
                  SelectedValue="{Binding SupplierId}" ToolTip="Выберите поставщика"/>

        <Label Grid.Row="4" Content="Цена закупки, руб."/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TBCostPrice" MaxLength="7"
                 ToolTip="Целое число от 1 до 1 000 000" PreviewTextInput="OnlyDigits_PreviewTextInput"/>

        <Label Grid.Row="5" Content="Цена продажи, руб."/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TBSalePrice" MaxLength="7"
                 ToolTip="Целое число от 1 до 1 000 000" PreviewTextInput="OnlyDigits_PreviewTextInput"/>

        <Label Grid.Row="6" Content="Гарантия, мес."/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TBWarranty" MaxLength="2"
                 ToolTip="От 0 до 60 месяцев" PreviewTextInput="OnlyDigits_PreviewTextInput"/>

        <Label Grid.Row="7" Content="Остаток на складе, шт."/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TBQuantity" MaxLength="5"
                 ToolTip="От 0 до 10 000 штук" PreviewTextInput="OnlyDigits_PreviewTextInput"/>

        <Button Grid.Row="8" Grid.ColumnSpan="2" x:Name="ButtonSave" Content="Сохранить" ToolTip="Сохранить товар"
                Click="ButtonSave_Click"/>
    </Grid>
</Page>