<Page x:Class="AMTech.Pages.AddSupplierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Поставщик">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <Label Content="Название"/>
        <TextBox x:Name="TBName" Text="{Binding Name}" MaxLength="150" ToolTip="Например: ООО «Техно-Опт»"/>
        <Label Content="Контакты"/>
        <TextBox x:Name="TBContacts" Text="{Binding Contacts}" MaxLength="200" ToolTip="Телефон и e-mail"/>
        <Label Content="ИНН"/>
        <TextBox x:Name="TBTaxId" Text="{Binding TaxId}" MaxLength="12" ToolTip="10 цифр (организация) или 12 цифр (ИП)"
                 PreviewTextInput="OnlyDigits_PreviewTextInput"/>
        <Button x:Name="ButtonSave" Content="Сохранить" ToolTip="Сохранить поставщика" Margin="0,15,0,0"
                Click="ButtonSave_Click"/>
    </StackPanel>
</Page>
