<Page x:Class="AMTech.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

        <StackPanel x:Name="LoginPanel">
            <Label Content="Логин"/>
            <Grid>
                <TextBox x:Name="TextBoxLogin" MaxLength="50" ToolTip="Введите логин"
                         TextChanged="TextBoxLogin_TextChanged"/>
                <Label x:Name="txtHintLogin" Content="Введите логин" Foreground="{DynamicResource HintBrush}"
                       MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>
            </Grid>
            <Label Content="Пароль"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox" MaxLength="50" ToolTip="Введите пароль"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                <Label x:Name="txtHintPass" Content="Введите пароль" Foreground="{DynamicResource HintBrush}"
                       MouseLeftButtonUp="txtHintPass_MouseLeftButtonUp"/>
            </Grid>
            <Button x:Name="ButtonEnter" Content="Вход" ToolTip="Войти в приложение" Margin="0,15,0,5"
                    Click="ButtonEnter_OnClick"/>
            <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Создать новую учётную запись"
                    Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля" ToolTip="Изменить свой пароль"
                    Click="ButtonChangePassword_Click"/>
        </StackPanel>

        <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
            <Label Content="Капча:"/>
            <TextBox x:Name="captcha" IsReadOnly="True" ContextMenu="{x:Null}"
                     CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                     Height="42" FontSize="20" FontStyle="Italic" FontWeight="Heavy" FontStretch="UltraCondensed"
                     Foreground="{DynamicResource CaptchaBrush}" HorizontalContentAlignment="Center"
                     ToolTip="Перепишите эти символы в поле ниже"/>
            <TextBox x:Name="captchaInput" MaxLength="6" Margin="0,5" ToolTip="Введите символы капчи"/>
            <Button x:Name="submitCaptcha" Content="Подтвердить" ToolTip="Подтвердить ввод капчи"
                    Click="submitCaptcha_Click"/>
        </StackPanel>
    </StackPanel>
</Page>