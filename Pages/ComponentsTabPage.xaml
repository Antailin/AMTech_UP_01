<Page x:Class="AMTech.Pages.ComponentsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Комплектующие">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
            <Label Content="Поиск:"/>
            <Grid Width="200" Margin="5">
                <TextBox x:Name="SearchBox" ToolTip="Поиск по названию товара" TextChanged="SearchBox_TextChanged"/>
                <Label x:Name="SearchHint" Content="Название товара" Foreground="{DynamicResource HintBrush}"
                       MouseLeftButtonUp="SearchHint_MouseLeftButtonUp"/>
            </Grid>
            <Label Content="Поставщик:"/>
            <ComboBox x:Name="SupplierBox" Width="230" Margin="5" ToolTip="Показать товары одного поставщика"
                      SelectionChanged="Filter_SelectionChanged"/>
            <Label Content="Сортировка:"/>
            <ComboBox x:Name="SortBox" Width="190" Margin="5" SelectedIndex="0" ToolTip="Порядок строк"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="Сначала дешёвые"/>
                <ComboBoxItem Content="Сначала дорогие"/>
            </ComboBox>
        </WrapPanel>

        <DataGrid x:Name="DataGridComponents" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Categories.Name}" Width="140"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Suppliers.Name}" Width="170"/>
                <DataGridTextColumn Header="Закупка, руб." Binding="{Binding CostPrice, StringFormat='0'}" Width="105"/>
                <DataGridTextColumn Header="Цена, руб." Binding="{Binding SalePrice, StringFormat='0'}" Width="90"/>
                <DataGridTextColumn Header="Гарантия, мес." Binding="{Binding WarrantyMonths}" Width="105"/>
                <DataGridTemplateColumn Width="185">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать данные"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" Content="Добавить" ToolTip="Добавить товар" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" ToolTip="Удалить выбранные товары" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
