<Page x:Class="AMTech.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Категория">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <Label Content="Название категории"/>
        <TextBox x:Name="TBCategoryName" Text="{Binding Name}" MaxLength="100" ToolTip="Например: Видеокарты"/>
        <Button x:Name="ButtonSaveCategory" Content="Сохранить" ToolTip="Сохранить категорию" Margin="0,15,0,0"
                Click="ButtonSaveCategory_Click"/>
    </StackPanel>
</Page>