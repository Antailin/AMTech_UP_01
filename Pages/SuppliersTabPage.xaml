<Page x:Class="AMTech.Pages.SuppliersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMTech.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Поставщики">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DataGridSupplier" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="Контакты" Binding="{Binding Contacts}" Width="*"/>
                <DataGridTextColumn Header="ИНН" Binding="{Binding TaxId}" Width="130"/>
                <DataGridTemplateColumn Width="185">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать данные"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" Content="Добавить" ToolTip="Добавить поставщика" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" ToolTip="Удалить выбранных поставщиков" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>